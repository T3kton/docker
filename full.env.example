# Settings for docker-compose.full.yml, copy to full.env and edit.

# REQUIRED
# the interface on the host that is on the network contractor will build machines on
LISTEN_INTERFACE=eth1
# the password for the contractor "root" user
ROOT_PASSWORD=

# site name and domain, the machines will be in this domain
#SITE_NAME=site1
#SITE_DOMAIN=site1.test

# a proxy the caching proxy should go through, if the host needs one to get out
#UPSTREAM_PROXY=http://myproxy:3128/
#NTP_SERVER=ntp.ubuntu.com

# set to have setupWizard reserve offsets 2-20 and use 21-29 as the dynamic pool
#IP_RESERVATION=1

# plugins for contractor (the respkgs) and the matching modules for subcontractor,
# ie: virtualbox, vcenter, proxmox, libvirt, ipmi, amt, docker, aws, azure
#CONTRACTOR_PLUGINS=virtualbox
#SUBCONTRACTOR_MODULES=manual,iputils,virtualbox

# extra respkgs to install, ie: disks-contractor_*.respkg for IPMI/AMT
#RESPKG_DIR=./respkgs
# a subcontractor.conf to use instead of generating one, for credentials and such,
# the file needs to be named subcontractor.conf
#SUBCONTRACTOR_CONFIG_DIR=./config

#DB_PASSWORD=contractor
